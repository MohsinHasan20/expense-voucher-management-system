# ========================================================
# Expense Voucher Management System - Environment Configuration
# Copy this file to .env or create server/.env and client/.env
# ========================================================

# SERVER CONFIGURATION
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# DATABASE
# Local MongoDB: mongodb://localhost:27017/expense_voucher_db
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/expense_voucher_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/expense_voucher_db

# AUTHENTICATION
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_security
JWT_EXPIRES_IN=1d
COOKIE_SECRET=super_secret_cookie_signing_key_pspl_2026

# UPLOADS
UPLOAD_DIR=uploads/signatures
MAX_FILE_SIZE_BYTES=2097152

# DEMO SEED CREDENTIALS (for development only)
DEMO_EMPLOYEE_EMAIL=employee@pspl.com
DEMO_EMPLOYEE_PASSWORD=Password123!
DEMO_DIRECTOR_EMAIL=director@pspl.com
DEMO_DIRECTOR_PASSWORD=Password123!
DEMO_ACCOUNTS_EMAIL=accounts@pspl.com
DEMO_ACCOUNTS_PASSWORD=Password123!

# FRONTEND CONFIGURATION (Vite)
VITE_API_URL=http://localhost:5000/api/v1
